# ==========================================
# Build Tools & Artifacts
# ==========================================
# Maven
target/
*.jar
*.war
*.ear

# Gradle
.gradle/
build/

# Do NOT ignore the build wrappers (they ensure portable builds)
!/.mvn/wrapper/maven-wrapper.jar
!/gradle/wrapper/gradle-wrapper.jar

# ==========================================
# IDE Specific Files
# ==========================================
# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws
out/

# Eclipse / Spring Tool Suite (STS)
.metadata/
.classpath
.project
.settings/
bin/
tmp/
*.launch
.factorypath
.springBeans
.sts4-cache

# Visual Studio Code
.vscode/

# ==========================================
# Secrets and Local Configurations
# ==========================================
# Never commit credentials or local overrides
.env
.env.local
*.properties.local
*.yml.local

# Un-comment below if you use local system-level application properties for secrets
# application-local.properties
# application-local.yml

# ==========================================
# System & Log Files
# ==========================================
# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db
Desktop.ini